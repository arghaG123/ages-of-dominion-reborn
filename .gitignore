__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
# Raw provider payloads and new bulky QA captures stay local.
design-preview/generated/**/provider-output/
qa/**/*.png
qa/**/*.jpg
qa/**/*.jpeg
qa/**/*.webp
qa/**/*.mp4
qa/**/*.zip
qa/**/*.apk
